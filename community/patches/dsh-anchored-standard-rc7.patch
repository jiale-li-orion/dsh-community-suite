From e6b41438ca55f2e04e8a225e4e2da3e59bc1c068 Mon Sep 17 00:00:00 2001
From: jiale li <2946192893@qq.com>
Date: Wed, 19 Aug 2026 11:46:46 +0800
Subject: [PATCH] fix: align wire think adapter with DSH rc.7

---
 shared/toolchoice-adapter.mjs              | 11 +++++++++--
 test/toolchoice-adapter.test.mjs           | 23 ++++++++++++++++++++++
 wire-think-standard/toolchoice-adapter.mjs | 11 +++++++++--
 3 files changed, 41 insertions(+), 4 deletions(-)

diff --git a/shared/toolchoice-adapter.mjs b/shared/toolchoice-adapter.mjs
index c3cfa3f..5ee4d08 100644
--- a/shared/toolchoice-adapter.mjs
+++ b/shared/toolchoice-adapter.mjs
@@ -182,9 +182,14 @@ function resolveThinking(options) {
   if (options.purpose === 'session-title') return { thinking: 'disabled' }
   const effort = options.reasoningEffort
   if (effort === 'off') return { thinking: 'disabled' }
-  if (effort === 'high' || effort === 'max') {
+  if (effort === 'low' || effort === 'high' || effort === 'max') {
     return { thinking: 'enabled', reasoningEffort: effort }
   }
+  if (effort !== undefined) {
+    const error = new Error(`DeepSeek does not support reasoning effort "${effort}"`)
+    error.code = 'UNSUPPORTED_REASONING_EFFORT'
+    throw error
+  }
   return {}
 }
 
@@ -194,7 +199,7 @@ function resolveThinking(options) {
  */
 export function serializeThinkRequest(options, config) {
   const messages = []
-  if (typeof options.system === 'string' && options.system.length > 0) {
+  if (typeof options.system === 'string') {
     messages.push({ role: 'system', content: options.system })
   }
   messages.push(...serializeMessages(options.messages))
@@ -453,10 +458,12 @@ export function apply(ctx, config) {
         name: model,
         inputModalities: ['text'],
         context: { contextWindow: 1_000_000 },
+        maxOutputTokens: 256_000,
         defaultMaxTokens: 256_000,
         reasoning: {
           efforts: [
             { id: 'off', name: 'Off' },
+            { id: 'low', name: 'Low' },
             { id: 'high', name: 'High' },
             { id: 'max', name: 'Max' },
           ],
diff --git a/test/toolchoice-adapter.test.mjs b/test/toolchoice-adapter.test.mjs
index 2e753ab..6ab50f6 100644
--- a/test/toolchoice-adapter.test.mjs
+++ b/test/toolchoice-adapter.test.mjs
@@ -102,6 +102,29 @@ test('thinking and sampling map like the official wire format', () => {
 
   const title = serializeThinkRequest({ ...OPTIONS(), purpose: 'session-title' }, {})
   assert.deepEqual(title.thinking, { type: 'disabled' })
+
+  const low = serializeThinkRequest({ ...OPTIONS(), reasoningEffort: 'low' }, {})
+  assert.deepEqual(low.thinking, { type: 'enabled' })
+  assert.equal(low.reasoning_effort, 'low')
+
+  assert.throws(
+    () => serializeThinkRequest({ ...OPTIONS(), reasoningEffort: 'medium' }, {}),
+    (error) => error.code === 'UNSUPPORTED_REASONING_EFFORT',
+  )
+})
+
+test('an explicitly empty system prompt remains on the wire', () => {
+  const body = serializeThinkRequest({ ...OPTIONS(), system: '' }, {})
+  assert.deepEqual(body.messages[0], { role: 'system', content: '' })
+})
+
+test('resolved model capacity and reasoning vocabulary match rc.7', async () => {
+  const { registration } = registerAdapterCtx({})
+  const model = await registration.adapter.resolveModel('deepseek-wire-think', 'deepseek-v4-pro')
+  assert.equal(model.context.contextWindow, 1_000_000)
+  assert.equal(model.maxOutputTokens, 256_000)
+  assert.equal(model.defaultMaxTokens, 256_000)
+  assert.deepEqual(model.reasoning.efforts.map((effort) => effort.id), ['off', 'low', 'high', 'max'])
 })
 
 test('history serialization follows the official nuances', () => {
diff --git a/wire-think-standard/toolchoice-adapter.mjs b/wire-think-standard/toolchoice-adapter.mjs
index c3cfa3f..5ee4d08 100644
--- a/wire-think-standard/toolchoice-adapter.mjs
+++ b/wire-think-standard/toolchoice-adapter.mjs
@@ -182,9 +182,14 @@ function resolveThinking(options) {
   if (options.purpose === 'session-title') return { thinking: 'disabled' }
   const effort = options.reasoningEffort
   if (effort === 'off') return { thinking: 'disabled' }
-  if (effort === 'high' || effort === 'max') {
+  if (effort === 'low' || effort === 'high' || effort === 'max') {
     return { thinking: 'enabled', reasoningEffort: effort }
   }
+  if (effort !== undefined) {
+    const error = new Error(`DeepSeek does not support reasoning effort "${effort}"`)
+    error.code = 'UNSUPPORTED_REASONING_EFFORT'
+    throw error
+  }
   return {}
 }
 
@@ -194,7 +199,7 @@ function resolveThinking(options) {
  */
 export function serializeThinkRequest(options, config) {
   const messages = []
-  if (typeof options.system === 'string' && options.system.length > 0) {
+  if (typeof options.system === 'string') {
     messages.push({ role: 'system', content: options.system })
   }
   messages.push(...serializeMessages(options.messages))
@@ -453,10 +458,12 @@ export function apply(ctx, config) {
         name: model,
         inputModalities: ['text'],
         context: { contextWindow: 1_000_000 },
+        maxOutputTokens: 256_000,
         defaultMaxTokens: 256_000,
         reasoning: {
           efforts: [
             { id: 'off', name: 'Off' },
+            { id: 'low', name: 'Low' },
             { id: 'high', name: 'High' },
             { id: 'max', name: 'Max' },
           ],
-- 
